#!/usr/bin/env bash
# entourage: set up and maintain this machine's copy of the software factory.
# It links the Herdr mods and layouts under herdr/, the agent skills under
# skills/ and the agent profiles under agents/, keeps the model and effort
# each profile runs on, and manages projects (groups of repos that show up in
# Herdr as spaces) and their tasks (a card an agent writes up, then a worktree
# of each repo on one branch, each shown as a tab in the project's space).
set -euo pipefail

usage() {
  cat <<'EOF'
entourage: set up and maintain this machine from the entourage repo

Usage:
  entourage install            first-time setup: link everything into the tools on this machine
  entourage update [--no-pull] get the latest entourage, link anything new, drop stale links, refresh Herdr
  entourage status             show what is linked and what is not, and check your projects
  entourage project new <name> [<path>...]  make a project from the template, with the repos at those paths
  entourage project add <name> <path>       add a repo that is already on this machine
  entourage project open <name>             show the project as a Herdr space
  entourage project ls [--json]             list projects and their repos (--json for programs)
  entourage project team <name> [<team>...] set the Linear teams whose cards are the project's, or print them
  entourage profile ls [--json]             show the model and effort each agent profile runs on
                                           (--json for programs)
  entourage profile set <profile> <model|effort> <value>
                                           set the model or the effort of one profile: write-up,
                                           build, reviewer or verifier
  entourage task ls <project> [--json]     list the open cards of the project's Linear teams, by status
  entourage task new <project> <card>      write a card up: an agent defines, plans and breaks it down
  entourage task start <project> <card> [<repo>[:<group>[,<group>...]] ...]
                                           start the work: a worktree per repo, opened as a tab
                                           where the agent builds the card
  entourage task build <project> <card>    start the agent that builds the card, in its task's tab
  entourage task finish <project> <card>   end a task whose work has merged: remove its worktrees,
                                           its branch in each repo and its folder, and close its tab
  entourage task watch <project> <card> [--once]
                                           watch the card's pull requests on GitHub until every one
                                           has merged, or one is closed or in conflict (--once: check once)
  entourage task handoff <project> <card>  record how a step ended: a handoff block on stdin
  entourage task log <project> [<card>] [--json]
                                           list a card's hand-offs and how long each step took,
                                           or with no card the cards that have hand-offs and where each stands
  entourage linear key                     save your Linear API key, so entourage can read and write Linear cards
  entourage linear read <card> [--json]    print a card whole: its head, description, comments and
                                           sub-issues (--json for programs)
  entourage linear type <card> <feat|fix|chore>
                                           set a card's type, its label in the Type group
  entourage linear section <card> <Specification|Plan|Breakdown> [--replace]
                                           add a section to a card, its body on stdin
  entourage linear move <card> <approved|started|review|done>
                                           move a card forward in Linear: to its team's first
                                           not-started status (Todo) with its sub-issues, its first
                                           started status, its last started one (In Review), or Done
  entourage help

A project groups repos that belong together, with a PROJECT.md saying what
each repo is for. A repo can be in several projects. `project new` also
marks the project's folder as trusted in Claude Code's own file
(~/.claude.json), so an agent started there is not stopped by the trust
question. It needs jq; without it Claude Code asks once.

A task is one piece of work in a project, usually a Linear card.
`task ls` lists the cards `task new` can be given: every card of the
project's Linear teams that is not done, cancelled or a duplicate, under its
status. It needs two things set once. `linear key` asks for a Linear API key
and saves it (make one in Linear, under Settings, Account, Security & access,
Personal API keys; Read permission is enough to list cards and for
`linear read`, which the card skills read a card with, and the card skills'
writes, `linear type`, `linear section` and `linear move`, need Write too).
`project team` names the project's teams by their keys: ABC for the team
whose cards are ABC-122. A project can name several teams, and several
projects can name the same one. Linear is asked with curl and its answer read
with jq.
`task new` takes the card's ID, like ABC-122. It opens a tab in the project's
Herdr space and starts an agent there, which writes the card up with the
sdlc-define, sdlc-plan and sdlc-breakdown skills and asks you to approve it.
claude starts with the entourage-write-up profile (see below).
With a Linear key saved, it first checks that Linear has the card, and stops
on a mistyped ID; when Linear cannot be asked, it starts the card anyway.
`task start` takes the card's ID too, once the card is written up. It asks
Linear for the card and names the branch from it, <type>/<card-id>-<short-name>
(https://conventionalbranch.org): the type is the card's label in the Type
group, and the short name is the first four words of its title, leaving out
a, an and the, like feat/abc-122-export-orders-as-csv. It needs your Linear
key, and stops before it makes anything when Linear has no such card, the
card has no type, or Linear cannot be asked. It makes a folder in the
project's tasks/ folder with a worktree of each repo on that branch, and
opens a tab for it. Then it types `entourage task build <project> <card>`
into the tab, which starts the agent on the card, with no one typing there.
Setup is off for now: with ENTOURAGE_SETUP=1, a repo with a justfile that has
a `setup` recipe gets `just setup` run in that tab first, so the checkout is
ready to work in before the agent starts. When Claude Code has not trusted the
repo yet, `task start` says that Claude Code will ask once in the tab.
Targets after the card narrow the task: `app` takes only that repo, and
`app:athlete` sets it up for its athlete group (`just setup athlete`).
Join several groups with a comma: `app:athlete,coach`.
`task build` starts the agent in the folder it is run in, which has to be the
card's task, with the entourage-build profile when it is claude (see below),
and with the first message in prompts/task-build.md: build the card
with the sdlc-build skill, review the build with the sdlc-review skill, then
put it up as a pull request with the sdlc-pr skill.
Run it again in the tab if the agent stops. The build makes the change the
card's Plan describes, runs the tests and commits on the task's branch. It
first installs what the tests need, the way the repo's docs say, and starts
no app, server or database. The review runs the tests, checks each Done when
item against the card's Plan and writes what it found on the card as a
Review. Neither pushes anything. What is not met goes back to sdlc-build.
When all is met, sdlc-pr pushes the task's branch and opens a pull request
into the default branch of each repo the work changed, saying how the review
showed each Done when item. You merge it. Meanwhile the agent watches the pull
requests on GitHub with `task watch`, and records the merge once every pull
request for the card has merged, with no one typing in the tab; telling it in
the tab that they have merged makes it check at once. When one is closed
without merging, it asks you whether to stop. When one is in conflict with its
default branch, it merges the default branch in, never by a rebase, fixes what
the tests find, has the review check it again and pushes, never forced; it
asks you only when the tests cannot pass or the fix would change a Done when
item. No agent merges a pull request.
entourage moves the card in Linear at four points: once your approval is
recorded, to the team's first not-started status (Todo in Lab, Ready for Dev
in PHY), and each of its sub-issues with it; once `task start` has opened
the tab, to the first started status (In Progress); once sdlc-pr has opened
every pull request, with `linear move <card> review`, to its last started
one (In Review); and once the merge is recorded, to its first completed one
(Done). A status is picked by its kind and its place in the team's order,
not by its name; a card only moves forward, one that is done or canceled is
never moved, and the key needs Write permission. A move that cannot be made
never stops the step: the approval, `task start` and the merge say so in a
note naming each card not moved, and sdlc-pr in its hand-off. `linear move`
alone exits non-zero then, saying why.
Each skill also runs alone in an agent: `/sdlc-build ABC-122`,
`/sdlc-review ABC-122`, `/sdlc-pr ABC-122`.
`task watch` asks GitHub, with gh, for the pull request of each worktree of
the card's task, skipping one whose branch has none, and prints a line for
each: merged, open, closed or conflict (open, and in conflict with its
default branch), then its URL. It checks every minute for the first 10
minutes after the newest was opened, every 5 minutes for the hour after that,
then every 30 minutes, and ends once every one has merged (exit 0), one is
closed without merging (exit 3) or one is in conflict (exit 4), a closed one
first. With --once it checks once, and exits 2 while one is still open. It
changes nothing.
`task finish` ends a task once its work has merged: it removes the task's
worktrees, deletes its branch in each repo, deletes its folder and closes its
tab. It checks first, and removes nothing when that would lose work: changes
that are not committed, commits that are not in the remote's default branch
(pushed or not), anything in the task folder outside its worktrees, or ignored
files the repo's `made-by-setup` recipe does not say its setup makes again.
It names every problem in every repo in one go.
`task handoff` is run by the agent each time a step ends or pauses, and
when the human answers a question. It reads a handoff block on stdin (step,
status, next and so on, one per line), refuses one that breaks the rules, and
records it. `task log` lists what was recorded for a card, with how long each
step took and how long it waited on the human. With no card it lists the
project's cards that have hand-offs, newest first, each with where it stands
and for how long: a card whose pull requests have merged stands at merged.
With --json it prints the same view as one line, for
programs: the Steps panel in Herdr draws it. Run
`entourage task handoff <project> <card>` with no block to see the rules.

Herdr's folder is ~/.config/herdr-app (HERDR_APP_HOME picks another).
Skills are linked into ~/.claude/skills, and agent profiles into
~/.claude/agents (CLAUDE_CONFIG_DIR picks another ~/.claude). The harness is
claude (ENTOURAGE_HARNESS picks another command).
Your projects are in ~/.config/entourage/projects (ENTOURAGE_HOME picks
another ~/.config/entourage). Hand-offs are recorded beside them, in
entourage.db, with sqlite3 (ENTOURAGE_SQLITE picks another command).

A profile is a Claude Code agent definition: the tools a session has,
whatever your own sessions have. claude starts with one, entourage-write-up
for `task new` and entourage-build for `task build`, and with Linear's MCP
server alone (agents/linear-mcp.json), not the servers of your own sessions.
Claude Code asks once to sign in to Linear as linear-server on a machine
where it is not signed in under that name. When the profile is not linked,
both stop before starting anything; run `entourage update`. Another harness
starts as it is, with no profile, model or effort.

Each profile runs on the model and effort that ~/.config/entourage/settings.json
names for it. `install` and `update` make the file when it is missing, with
every profile on opus at xhigh effort, and never change one that is there.
`profile ls` shows them, and `profile set` changes one: write-up is the agent
`task new` starts, build the one `task build` starts, and reviewer and
verifier the entourage-reviewer and entourage-verifier subagents, for work on
entourage itself. A model is one of claude's aliases (fable, opus, sonnet,
haiku) or a full model name like claude-opus-5-5, and an effort is low,
medium, high, xhigh or max; anything else is refused, and the file is left as
it was. claude starts with --model= and --effort=, which beat the profile's
own model and your own Claude Code settings; only CLAUDE_CODE_EFFORT_LEVEL
beats the effort. A clone of entourage writes the two subagents into
~/.claude/agents, with their model and effort, at `install`, at `update` and
at each `profile set` for one of them, and replaces or removes only a file it
wrote; an npm install writes neither. A profile or value the file leaves out
is opus at xhigh. A file that is not valid settings stops `task new` and
`task build` before an agent starts, saying what in it is wrong, and
`status` says so too. The file is read with jq. The Agent settings button at
the right end of Herdr's tab bar shows and changes them with these commands.

These variables, and your Linear key as LINEAR_API_KEY, can be exported in
your shell or written as NAME=value lines in ~/.config/entourage/.env, which
`linear key` writes for you and only you can read. A variable you export wins
over its line in the file, unless it is empty; of two lines for a name, the
last is used. Herdr starts commands without your shell's exports, so what a
mod's run of entourage needs has to be in the file. ENTOURAGE_HOME and
ENTOURAGE_LIVE are the variables the file cannot set.

The copy of entourage in a git worktree of the entourage repo, run as
./cli/entourage, is a change being built. It runs only the commands that
read: help, status, project ls, project team <name> with no teams,
profile ls, task ls, task log and task watch. Every other command stops before it does anything,
says why, and leaves this machine as it was. ENTOURAGE_LIVE=1, set for that one run,
runs it for real. The installed entourage is never stopped, whatever folder
it is run from.
EOF
}

# --- where things are -------------------------------------------------------

# The repo root, found from this script's real location (it may be run through
# the ~/.local/bin/entourage link).
self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  dir=$(cd -P "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  case $self in /*) ;; *) self=$dir/$self ;; esac
done
REPO=$(cd -P "$(dirname "$self")/.." && pwd)

# The user's own things: their projects, and what entourage keeps for them.
# They live outside the repo so that they are never published and an npm
# reinstall does not delete them.
ENT_HOME=${ENTOURAGE_HOME:-$HOME/.config/entourage}

# entourage's own environment: NAME=value lines in this file, for the
# variables that would otherwise be exported in a shell. Herdr starts a
# command without a shell's exports, so a variable set only in a shell profile
# is missing when a mod runs entourage, and the file is where it is found.
ENV_FILE=$ENT_HOME/.env
# Whether the Linear key came with the environment, before the file is read.
KEY_EXPORTED=${LINEAR_API_KEY:+1}

# Take entourage's variables from the file. The file is read, never run: a
# line that is not NAME=value is skipped, and nothing in a value is expanded.
# What a line may hold:
#   - export before the name, spaces around the =, one pair of quotes around
#     the value, and a # comment after a value with no quotes;
#   - of two lines for a name, the last one;
#   - a variable already in the environment wins over the file, unless it is
#     empty, which counts as not set.
# Only the variables entourage reads are taken: a line for PATH or anything
# else is skipped, and so is ENTOURAGE_HOME, which says where this file is.
# ENTOURAGE_LIVE is skipped too: it lets a worktree's copy change the
# machine, so it is set for one run, never left on in the file (guard.sh).
# HERDR_APP_HOME and CLAUDE_CONFIG_DIR are exported, so a program entourage
# starts finds the same folders it does. The Linear key is not: only
# entourage reads it, and it hands it to curl on stdin.
load_env() {
  local line name value from_file=' '
  local re='^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*(.*)$'
  [ -e "$ENV_FILE" ] || return 0
  # Stop rather than go on without the file: its settings would be missing,
  # and `linear key` would write it anew with only the key in it. Anything
  # there that is not a file, such as a folder, stops it too.
  [ -f "$ENV_FILE" ] || {
    printf 'entourage: %s is not a file, and entourage reads its settings from a file there. Move it aside, then run this again.\n' \
      "$ENV_FILE" >&2
    exit 1
  }
  [ -r "$ENV_FILE" ] || {
    printf 'entourage: cannot read %s. It should be yours, and readable by you only: check its owner, then run: chmod 600 %s\n' \
      "$ENV_FILE" "$ENV_FILE" >&2
    exit 1
  }
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    # The mark some editors put at the start of a file.
    line=${line#$'\357\273\277'}
    [[ $line =~ $re ]] || continue
    name=${BASH_REMATCH[2]} value=${BASH_REMATCH[3]}
    case $name in
      ENTOURAGE_HOME | ENTOURAGE_LIVE) continue ;;
      ENTOURAGE_* | LINEAR_API_KEY | HERDR_APP_HOME | CLAUDE_CONFIG_DIR) ;;
      *) continue ;;
    esac
    # A name the file has set already is set again; one that came with the
    # environment is left as it is.
    case $from_file in
      *" $name "*) ;;
      *) [ -z "${!name:-}" ] || continue ;;
    esac
    from_file="$from_file$name "
    # A # after a space starts a comment, in a value with no quotes.
    case $value in
      \"* | \'*) ;;
      \#*) value= ;;
      *) value=${value%%[[:space:]]#*} ;;
    esac
    # Spaces after the value, then one pair of quotes around it.
    value=${value%"${value##*[![:space:]]}"}
    case $value in
      \"*\") value=${value#\"}; value=${value%\"} ;;
      \'*\') value=${value#\'}; value=${value%\'} ;;
    esac
    if [ "$name" = LINEAR_API_KEY ]; then
      # Set for entourage alone. -n also covers a key that came exported but
      # empty, so that no program entourage starts finds it either way.
      LINEAR_API_KEY=$value
      export -n LINEAR_API_KEY
    else
      export "$name=$value"
    fi
  done < "$ENV_FILE"
}
load_env

APP_HOME=${HERDR_APP_HOME:-$HOME/.config/herdr-app}
# Where Claude Code looks for a person's own skills.
SKILLS_HOME=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills
# Where Claude Code looks for a person's own agent definitions: the profiles
# `task new` and `task build` start claude with.
AGENTS_HOME=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/agents
# Claude Code's own record for this machine. Among much else it holds the
# folders Claude Code starts in without asking.
CLAUDE_STATE=${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json
BIN_DIR=$HOME/.local/bin
HERDR_INSTALL='curl -fsSL https://releases.herdr.dev/app/install.sh | sh'
# What `update` reinstalls when entourage came from npm rather than a git clone.
NPM_SPEC=${ENTOURAGE_NPM_SPEC:-@johngaynor/entourage}

PROJECTS=$ENT_HOME/projects
# The model and effort each agent profile runs on (settings.sh). Not the env
# file: a Herdr mod changes it, and the env file holds the Linear key.
SETTINGS=$ENT_HOME/settings.json
TEMPLATE=$REPO/herdr/projects/template
# A PROJECT.md that still has this line has not been filled in.
TEMPLATE_MARK='<!-- entourage:template -->'

# --- the rest of the CLI ----------------------------------------------------

# Sourced, so every file shares the settings above and each other's functions.
LIB=$REPO/cli/lib
for part in common guard links recipes trust settings project linear task finish watch handoff commands; do
  [ -f "$LIB/$part.sh" ] ||
    { printf 'entourage: %s is missing; reinstall entourage\n' "$LIB/$part.sh" >&2; exit 1; }
  # shellcheck source=/dev/null
  . "$LIB/$part.sh"
done

# A worktree's copy runs only the commands that read, unless asked (guard.sh).
guard_worktree "$@"

case ${1:-help} in
  install) shift; cmd_install "$@" ;;
  update) shift; cmd_update "$@" ;;
  status) shift; cmd_status "$@" ;;
  project) shift; cmd_project "$@" ;;
  task) shift; cmd_task "$@" ;;
  linear) shift; cmd_linear "$@" ;;
  profile) shift; cmd_profile "$@" ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 2 ;;
esac
