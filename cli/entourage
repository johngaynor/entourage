#!/usr/bin/env bash
# entourage: set up and maintain this machine's copy of the software factory.
# It links the Herdr mods and layouts under herdr/, and manages projects:
# groups of repos that show up in Herdr as spaces.
set -euo pipefail

usage() {
  cat <<'EOF'
entourage: set up and maintain this machine from the entourage repo

Usage:
  entourage install            first-time setup: link everything into the tools on this machine
  entourage update [--no-pull] get the latest entourage, link anything new, drop stale links, refresh Herdr
  entourage status             show what is linked and what is not, and check your projects
  entourage project new <name>         make a project from the template
  entourage project add <name> <path>  add a repo that is already on this machine
  entourage project open <name>        show the project as a Herdr space
  entourage project ls                 list projects and their repos
  entourage help

A project groups repos that belong together, with a PROJECT.md saying what
each repo is for. A repo can be in several projects.

Herdr's folder is ~/.config/herdr-app (HERDR_APP_HOME picks another).
Your projects are in ~/.config/entourage/projects (ENTOURAGE_HOME picks
another ~/.config/entourage).
EOF
}

# --- where things are -------------------------------------------------------

# The repo root, found from this script's real location (it may be run through
# the ~/.local/bin/entourage link).
self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  dir=$(cd -P "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  case $self in /*) ;; *) self=$dir/$self ;; esac
done
REPO=$(cd -P "$(dirname "$self")/.." && pwd)

APP_HOME=${HERDR_APP_HOME:-$HOME/.config/herdr-app}
BIN_DIR=$HOME/.local/bin
HERDR_INSTALL='curl -fsSL https://releases.herdr.dev/app/install.sh | sh'
# What `update` reinstalls when entourage came from npm rather than a git clone.
NPM_SPEC=${ENTOURAGE_NPM_SPEC:-@johngaynor/entourage}

# The user's own projects. They live outside the repo so that they are never
# published and an npm reinstall does not delete them.
ENT_HOME=${ENTOURAGE_HOME:-$HOME/.config/entourage}
PROJECTS=$ENT_HOME/projects
TEMPLATE=$REPO/herdr/projects/template
# A PROJECT.md that still has this line has not been filled in.
TEMPLATE_MARK='<!-- entourage:template -->'

# A git clone updates with `git pull`; an npm install updates through npm.
is_clone() { [ -e "$REPO/.git" ]; }

say() { printf '%s\n' "$*"; }
die() { printf 'entourage: %s\n' "$*" >&2; exit 1; }

herdr_app() {
  if command -v herdr-app >/dev/null 2>&1; then herdr-app "$@"
  elif [ -x "$BIN_DIR/herdr-app" ]; then "$BIN_DIR/herdr-app" "$@"
  else return 127
  fi
}

have_herdr() { command -v herdr-app >/dev/null 2>&1 || [ -x "$BIN_DIR/herdr-app" ]; }

# --- linking ----------------------------------------------------------------

# Every (source, destination) pair this repo wants linked, one per line,
# tab-separated.
wanted() {
  local m l
  for m in "$REPO"/herdr/mods/*/; do
    [ -d "$m" ] || continue
    m=${m%/}
    printf '%s\t%s\n' "$m" "$APP_HOME/mods/${m##*/}"
  done
  for l in "$REPO"/herdr/layouts/*.json; do
    [ -f "$l" ] || continue
    printf '%s\t%s\n' "$l" "$APP_HOME/layouts/${l##*/}"
  done
}

# linked | missing | elsewhere (a link to somewhere else) | blocked (a real file)
state_of() {
  local src=$1 dst=$2
  if [ -L "$dst" ]; then
    [ "$(readlink "$dst")" = "$src" ] && echo linked || echo elsewhere
  elif [ -e "$dst" ]; then echo blocked
  else echo missing
  fi
}

label() { local dst=$1; say "${dst#"$APP_HOME"/}"; }

# Link what is missing. Never touches a real file or someone else's link.
link_all() {
  local src dst added=0 skipped=0
  mkdir -p "$APP_HOME/mods" "$APP_HOME/layouts"
  while IFS=$'\t' read -r src dst; do
    case $(state_of "$src" "$dst") in
      linked) ;;
      missing) ln -s "$src" "$dst"; say "  linked   $(label "$dst")"; added=$((added + 1)) ;;
      elsewhere) say "  skipped  $(label "$dst") (already a link to $(readlink "$dst"))"; skipped=$((skipped + 1)) ;;
      blocked) say "  skipped  $(label "$dst") (a real file is in the way; move it aside to use ours)"; skipped=$((skipped + 1)) ;;
    esac
  done < <(wanted)
  [ "$added" -gt 0 ] || say "  nothing new to link"
  CHANGED=$((CHANGED + added))
  SKIPPED=$skipped
}

# Remove links that point into this repo at something that no longer exists
# (a mod or layout that was deleted or renamed upstream).
prune() {
  local dst target
  for dst in "$APP_HOME"/mods/* "$APP_HOME"/layouts/*; do
    [ -L "$dst" ] || continue
    target=$(readlink "$dst")
    case $target in "$REPO"/herdr/*) ;; *) continue ;; esac
    if [ ! -e "$target" ]; then
      rm "$dst"; say "  removed  $(label "$dst") (no longer in the repo)"
      CHANGED=$((CHANGED + 1))
    fi
  done
}

# Herdr does not notice edits made through a link. Switching to a shipped
# layout and back makes it re-read our layouts and mods.
refresh_herdr() {
  local current
  current=$(herdr_app status 2>/dev/null | sed -n 's/.*"layout": *"\([^"]*\)".*/\1/p' | head -n 1) || true
  if [ -z "$current" ]; then
    say "  Herdr is not running; it will pick everything up when it starts"
    return 0
  fi
  local other=main
  [ "$current" = main ] && other=terminals
  herdr_app do layout.switch "{\"name\":\"$other\"}" >/dev/null 2>&1 || true
  if herdr_app do layout.switch "{\"name\":\"$current\"}" >/dev/null 2>&1; then
    say "  refreshed Herdr (layout: $current)"
  else
    say "  could not switch Herdr back to '$current'; pick it from the Layout dropdown or press ctrl-shift-l"
  fi
}

require_herdr() {
  have_herdr || die "Herdr is not installed. Install it, open it once, then run this again:
  $HERDR_INSTALL"
  [ -d "$APP_HOME" ] || die "$APP_HOME does not exist yet. Open Herdr once so it creates its folder, then run this again."
}

# --- projects ---------------------------------------------------------------

# A project is a folder in $PROJECTS:
#   PROJECT.md   what the project is and what belongs in each repo
#   repos        one repo path per line (~/ for the home folder, # for comments)
#   links/       generated: a link to each repo, named after its folder
#   CLAUDE.md, AGENTS.md   generated: links to PROJECT.md, so agents read it

valid_name() { case ${1:-} in '' | *[!a-z0-9-]*) return 1 ;; esac; }

# Print a project's folder, or stop if there is no such project.
project_dir() {
  local name=${1:-}
  [ -n "$name" ] || die "which project? See: entourage project ls"
  valid_name "$name" && [ -d "$PROJECTS/$name" ] ||
    die "no project called '$name'. Make it with: entourage project new $name"
  (cd -P "$PROJECTS/$name" && pwd)
}

# Print a project's repo paths, absolute, one per line.
project_repos() {
  local dir=$1 line
  [ -f "$dir/repos" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      '' | '#'*) continue ;;
      '~/'*) line=$HOME/${line#'~/'} ;;
    esac
    printf '%s\n' "$line"
  done < "$dir/repos"
}

is_repo() { [ -e "$1/.git" ]; }

# Rebuild what is generated in a project folder. Only links are ever removed
# or replaced; a real file in the way is reported and left alone.
sync_links() {
  local dir=$1 src dst base names=$'\n'
  mkdir -p "$dir/links"
  while IFS= read -r src; do
    base=${src##*/}
    dst=$dir/links/$base
    names+=$base$'\n'
    is_repo "$src" || say "  warning: $src is missing or is not a git repo"
    if [ -L "$dst" ]; then
      [ "$(readlink "$dst")" = "$src" ] || { rm "$dst"; ln -s "$src" "$dst"; }
    elif [ -e "$dst" ]; then
      say "  skipped  links/$base (a real file is in the way)"
    else
      ln -s "$src" "$dst"
    fi
  done < <(project_repos "$dir")
  for dst in "$dir"/links/*; do
    [ -L "$dst" ] || continue
    case $names in *$'\n'"${dst##*/}"$'\n'*) ;; *) rm "$dst" ;; esac
  done
  for base in CLAUDE.md AGENTS.md; do
    [ -e "$dir/$base" ] || [ -L "$dir/$base" ] || ln -s PROJECT.md "$dir/$base"
  done
}

project_new() {
  local name=${1:-} dir
  valid_name "$name" || die "a project name is lowercase letters, digits and dashes, like: my-project"
  dir=$PROJECTS/$name
  [ ! -e "$dir" ] || die "project '$name' already exists at $dir"
  [ -f "$TEMPLATE/PROJECT.md" ] || die "the project template is missing from $TEMPLATE"
  mkdir -p "$dir"
  sed "s/__NAME__/$name/" "$TEMPLATE/PROJECT.md" > "$dir/PROJECT.md"
  : > "$dir/repos"
  sync_links "$dir"
  say "Made project '$name' at $dir"
  say "Next:"
  say "  entourage project add $name <path to a repo>"
  say "  fill in $dir/PROJECT.md"
  say "  entourage project open $name"
}

project_add() {
  local name=${1:-} path=${2:-} dir abs other stored
  dir=$(project_dir "$name")
  [ -n "$path" ] || die "which repo? Usage: entourage project add $name <path>"
  [ -d "$path" ] || die "$path is not a folder"
  abs=$(cd "$path" && pwd -P)
  is_repo "$abs" || die "$abs is not a git repo (the top folder of a clone is needed)"
  while IFS= read -r other; do
    [ "$other" != "$abs" ] || die "$abs is already in project '$name'"
    [ "${other##*/}" != "${abs##*/}" ] ||
      die "project '$name' already has a repo called ${abs##*/} ($other); two repos in a project cannot share a folder name"
  done < <(project_repos "$dir")
  case $abs in
    "$HOME"/*) stored="~/${abs#"$HOME"/}" ;;
    *) stored=$abs ;;
  esac
  printf '%s\n' "$stored" >> "$dir/repos"
  sync_links "$dir"
  say "Added ${abs##*/} to project '$name'"
  say "Describe what it owns in $dir/PROJECT.md"
}

project_open() {
  local name=${1:-} dir id
  dir=$(project_dir "$name")
  require_herdr
  sync_links "$dir"
  # Find an open space whose folder is this project's. `herdr-app ls` prints
  # indented JSON; a space's own "id" and "folder" sit at six spaces. Closed
  # spaces are listed after "recent" in the same shape, so stop there.
  id=$(herdr_app ls 2>/dev/null | awk -v want="$dir" '
    /^  "recent"/       { exit }
    /^      "id": /     { id = $2; gsub(/[",]/, "", id) }
    /^      "folder": / { f = $0; sub(/^ *"folder": "/, "", f); sub(/",?$/, "", f)
                          if (f == want) { print id; exit } }') || true
  if [ -n "$id" ]; then
    herdr_app do space.select "{\"id\":\"$id\"}" >/dev/null 2>&1 ||
      die "could not show the space for '$name'. Is Herdr open?"
    say "Showing the space for '$name'"
  else
    herdr_app do space.new "{\"name\":\"$name\",\"folder\":\"$dir\"}" >/dev/null 2>&1 ||
      die "could not make a space for '$name'. Is Herdr open?"
    say "Opened a space for '$name' in $dir"
  fi
}

project_ls() {
  local d any=0 repo
  for d in "$PROJECTS"/*/; do
    [ -d "$d" ] || continue
    any=1
    d=${d%/}
    say "${d##*/}"
    while IFS= read -r repo; do say "  $repo"; done < <(project_repos "$d")
  done
  [ "$any" = 1 ] || say "No projects yet. Make one with: entourage project new <name>"
}

# Print what is wrong with each project; return how many problems there are.
check_projects() {
  local d repo problems=0 bad
  for d in "$PROJECTS"/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    bad=0
    if [ ! -f "$d/PROJECT.md" ]; then
      say "  problem    ${d##*/}: PROJECT.md is missing"; bad=$((bad + 1))
    elif grep -qF -- "$TEMPLATE_MARK" "$d/PROJECT.md"; then
      say "  problem    ${d##*/}: PROJECT.md is still the template; fill it in and delete its first line"; bad=$((bad + 1))
    fi
    while IFS= read -r repo; do
      is_repo "$repo" || { say "  problem    ${d##*/}: $repo is missing or is not a git repo"; bad=$((bad + 1)); }
    done < <(project_repos "$d")
    [ "$bad" -gt 0 ] || say "  ok         ${d##*/}"
    problems=$((problems + bad))
  done
  return "$problems"
}

cmd_project() {
  case ${1:-} in
    new) shift; project_new "$@" ;;
    add) shift; project_add "$@" ;;
    open) shift; project_open "$@" ;;
    ls | list) shift; project_ls ;;
    *) die "usage: entourage project new|add|open|ls (see: entourage help)" ;;
  esac
}

# --- commands ---------------------------------------------------------------

cmd_install() {
  require_herdr
  CHANGED=0 SKIPPED=0
  say "Linking mods and layouts into $APP_HOME"
  link_all

  # npm already put the command on PATH; a clone has to do it itself.
  if is_clone; then
    say "Putting entourage on your PATH"
    mkdir -p "$BIN_DIR"
    local me=$REPO/cli/entourage dst=$BIN_DIR/entourage
    case $(state_of "$me" "$dst") in
      linked) say "  already at $dst" ;;
      missing) ln -s "$me" "$dst"; say "  linked   $dst" ;;
      *) say "  skipped  $dst (something else is already there)" ;;
    esac
    case ":$PATH:" in
      *":$BIN_DIR:"*) ;;
      *) say "  note: $BIN_DIR is not on your PATH; add it to run 'entourage' from anywhere" ;;
    esac
  fi

  say "Refreshing Herdr"
  refresh_herdr
  say "Done. Pick a layout from the Layout dropdown, or press ctrl-shift-l."
}

cmd_update() {
  local pull=1
  case ${1:-} in
    --no-pull) pull=0 ;;
    '') ;;
    *) die "unknown option for update: $1" ;;
  esac
  require_herdr
  CHANGED=0 SKIPPED=0
  local before=none after=none
  if [ "$pull" = 1 ] && ! is_clone; then
    # Installed by npm: reinstall, then hand over to the new copy to relink.
    command -v npm >/dev/null 2>&1 || die "npm is needed to update this install, and it is not on your PATH."
    say "Updating entourage with npm ($NPM_SPEC)"
    npm install -g "$NPM_SPEC" || die "npm install failed; nothing was changed in Herdr."
    exec entourage update --no-pull
  fi
  if is_clone; then before=$(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo none); fi
  if [ "$pull" = 1 ]; then
    say "Pulling $REPO"
    git -C "$REPO" pull --ff-only || die "git pull failed; fix that in $REPO and run update again."
  fi
  if is_clone; then after=$(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo none); fi

  say "Linking mods and layouts into $APP_HOME"
  link_all
  prune

  say "Refreshing Herdr"
  if [ "$before" != "$after" ] || [ "$CHANGED" -gt 0 ] || [ "$pull" = 0 ]; then
    refresh_herdr
  else
    say "  nothing changed"
  fi
}

cmd_status() {
  say "Repo:  $REPO"
  say "Herdr: $APP_HOME"
  have_herdr || say "  Herdr is not installed ($HERDR_INSTALL)"
  local src dst s problems=0
  while IFS=$'\t' read -r src dst; do
    s=$(state_of "$src" "$dst")
    [ "$s" = linked ] || problems=$((problems + 1))
    printf '  %-10s %s\n' "$s" "${dst#"$APP_HOME"/}"
  done < <(wanted)
  [ "$problems" = 0 ] || say "$problems not linked. Run: entourage update"
  say "Projects: $PROJECTS"
  local project_problems=0
  check_projects || project_problems=$?
  if [ "$problems" -gt 0 ] || [ "$project_problems" -gt 0 ]; then
    [ "$project_problems" = 0 ] || say "$project_problems project problem(s)."
    return 1
  fi
  say "Everything is in order."
}

case ${1:-help} in
  install) shift; cmd_install "$@" ;;
  update) shift; cmd_update "$@" ;;
  status) shift; cmd_status "$@" ;;
  project) shift; cmd_project "$@" ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 2 ;;
esac
